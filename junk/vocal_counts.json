e2d\u7684\u60c5\u611f\u548c\u6c1b\u56f4\u4e0e\u8fd9\u4e9b\u573a\u666f\u76f8\u7b26\u3002": 1, "\u7d27\u5f20\u3002": 1, "\u8f7b\u677e\u6109\u5feb\uff1b\u5e74\u4ee3\uff1a\u73b0\u4ee3\uff1b\u8282\u594f\uff1a\u4e2d\u7b49\uff1b\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u9152\u5427\u6216\u6d3e\u5bf9\u3002\u8fd9\u9996\u6b4c\u66f2\u7684\u8f7b\u677e\u6109\u5feb\u7684\u65cb\u5f8b\u548c\u6b4c\u8bcd\u4ee5\u53ca\u6d41\u884c\u97f3\u4e50\u7684\u98ce\u683c\u4f7f\u5176\u6210\u4e3a\u9002\u5408\u5728\u6d3e\u5bf9\u6216\u9152\u5427\u7b49\u573a\u5408\u64ad\u653e\u7684\u80cc\u666f\u97f3\u4e50\u3002": 1, "\u75f4\u60c5": 2, "\u632f\u594b\u3002\u5e74\u4ee3\uff1a2010\u5e74\u4ee3\u3002\u8282\u594f\uff1a\u4e2d\u5feb\u8282\u594f\u3002\u6700\u4f73\u573a\u666f\uff1a\u6e38\u620f\u4e3b\u9898\u66f2": 1, "\u7535\u5f71\u6216\u52a8\u6f2b\u7247\u5934\u66f2\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u65cb\u5f8b\u6b22\u5feb": 1, "\u8282\u594f\u9c9c\u660e\uff0c\u9002\u5408\u7528\u4e8e\u6e38\u620f\u6216\u7535\u5f71\u52a8\u753b\u7b49\u573a\u666f\u7684\u914d\u4e50\u3002": 1, "\u72c2\u91ce": 1, "\u4e0d\u786e\u5b9a\u3002": 1, "\u4e0d\u7518": 1, "\u751c\u871c\uff1b\u5e74\u4ee3\uff1a2010\u5e74\u4ee3\uff1b\u8282\u594f\uff1a\u8f7b\u5feb\u3002\u6700\u4f73\u573a\u666f\uff1a\u6c99\u6ee9\u6216\u6d77\u8fb9\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u8282\u594f\u8f7b\u5feb\uff0c\u4e50\u5668\u8f7b\u67d4\uff0c\u914d\u5408\u6d77\u8fb9\u7684\u666f\u8272\u8ba9\u4eba\u611f\u5230\u8f7b\u677e\u6109\u60a6\uff0c\u9002\u5408\u653e\u677e\u5fc3\u60c5\u3002": 1, "\u60a0\u626c\u6fc0\u6602\uff1b\u5e74\u4ee3\uff1a\u73b0\u4ee3\uff1b\u8282\u594f\uff1a\u7f13\u6162\u8212\u7f13\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u5927\u8349\u539f\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u4e2d\u7684\u9a6c\u5934\u7434\u548c\u8499\u53e4\u6c11\u6b4c\u5143\u7d20\u4e0e\u5927\u8349\u539f\u7684\u6587\u5316\u6c1b\u56f4\u76f8\u5f97\u76ca\u5f70\uff0c\u80fd\u591f\u66f4\u597d\u5730\u5c55\u73b0\u51fa\u6b4c\u66f2\u6240\u8868\u8fbe\u7684\u60c5\u611f\u548c\u4e3b\u65e8\u3002": 1, "\u8b66\u60d5": 1, "\u8b66\u89c9": 1, "\u5d07\u656c": 2, "\u6c89\u601d\u548c\u6000\u65e7\u3002": 1, "\u575a\u5b9a\uff1b\u5e74\u4ee3\uff1a1990\u5e74\u4ee3\uff1b\u8282\u594f\uff1a\u4e2d\u7b49\u8282\u594f\u3002\u6700\u4f73\u573a\u666f\uff1a\u56fd\u5e86\u9605\u5175": 1, "\u653f\u6cbb\u5ba3\u4f20\u573a\u5408\u3002\u539f\u56e0\uff1a\u8fd9\u9996\u6b4c\u66f2\u901a\u8fc7\u6b4c\u9882\u81ea\u5df1\u4f5c\u4e3a\u7956\u56fd\u5efa\u8bbe\u7684\u4e00\u4efd\u5b50\u7684\u81ea\u8c6a\u611f\u548c\u575a\u5b9a\u4fe1\u5ff5\uff0c\u8868\u8fbe\u4e86\u5bf9\u7956\u56fd\u7684\u6df1\u539a\u70ed\u7231\uff0c\u9002\u5408\u5728\u56fd\u5e86\u9605\u5175\u548c\u653f\u6cbb\u5ba3\u4f20\u573a\u5408\u64ad\u653e\u3002": 1, "\u60b2\u4f24\u548c\u54c0\u5a49": 1, "\u632f\u594b\u3002\u5e74\u4ee3\uff1a2000\u5e74\u4ee3\u3002\u8282\u594f\uff1a\u4e2d\u7b49\u5feb\u677f\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u5728\u8fb9\u7586\u5730\u533a\uff0c\u89c2\u8d4f\u7956\u56fd\u7684\u5efa\u8bbe\u6210\u679c\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u4e3b\u9898\u548c\u60c5\u7eea\u4e0e\u8fb9\u7586\u5730\u533a\u7684\u5efa\u8bbe\u6210\u679c\u76f8\u7b26\u5408\u3002": 1, "\u611f\u4f24\u3002\u5e74\u4ee3\uff1a2000\u5e74\u4ee3\u3002\u8282\u594f\uff1a\u7f13\u6162\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u4e61\u6751": 1, "\u6545\u4e61": 1, "\u5bb6\u4e2d": 1, "\u65c5\u9014\u4e2d\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u5145\u6ee1\u7740\u5bf9\u6545\u4e61\u7684\u6df1\u60c5\u6000\u5ff5\u548c\u5bf9\u6210\u957f\u7684\u56de\u6eaf\uff0c\u9002\u5408\u5728\u6e29\u99a8\u7684\u5bb6\u4e2d\u6216\u8fdc\u884c\u9014\u4e2d\u64ad\u653e\uff0c\u8ba9\u4eba\u611f\u53d7\u5230\u5bb6\u7684\u6e29\u6696\u548c\u8ffd\u5fc6\u7684\u60c5\u611f\u3002": 1, "\u5145\u6ee1\u529b\u91cf": 2, "\u6df1\u9083": 1, "\u8c6a\u60c5": 1, "\u758f\u72c2": 1, "\u6ca7\u6851": 1, "\u51dd\u91cd": 1, "\u63a2\u7d22": 1, "\u6de1\u7136\u7684\u5931\u671b": 1, "\u9057\u61be": 1, "\u67d4\u548c\u3002": 1, "\u6e29\u99a8\u3002\u5e74\u4ee3\uff1a2000\u5e74\u4ee3\u3002\u8282\u594f\uff1a\u4e2d\u7b49\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u5a5a\u793c\u4eea\u5f0f\u6216\u6d6a\u6f2b\u7ea6\u4f1a\u3002\u8fd9\u9996\u6b4c\u66f2\u7684\u4e3b\u9898\u548c\u60c5\u7eea\u975e\u5e38\u9002\u5408\u5728\u6d6a\u6f2b\u7684\u573a\u666f\u4e2d\u64ad\u653e\uff0c\u80fd\u591f\u589e\u5f3a\u573a\u666f\u7684\u6c1b\u56f4\u3002": 1, "\u594b\u6597": 4, "\u611f\u52a8\u3002\u5e74\u4ee3\uff1a\u73b0\u4ee3\u3002\u8282\u594f\uff1a\u4e2d\u7b49\u8282\u594f\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u8fd0\u52a8\u4f1a": 1, "\u6bd5\u4e1a\u5178\u793c": 1, "\u6f14\u8bb2\u6bd4\u8d5b\u7b49\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u6fc0\u52b1\u4eba\u4eec\u575a\u5b9a\u81ea\u5df1\u7684\u68a6\u60f3\uff0c\u8ffd\u6c42\u81ea\u5df1\u7684\u8363\u8000\uff0c\u9002\u5408\u5728\u8fd9\u4e9b\u573a\u666f\u4e2d\u64ad\u653e\u3002": 1, "\u8654\u8bda": 1, "\u6c89\u95f7": 2, "\u70e6\u8e81\u3002": 1, "\u611f\u6168\u3002": 1, "\u7231\u3002": 1, "\u5411\u5f80\uff1b\u5e74\u4ee3\uff1a2010\u5e74\u4ee3\uff1b\u8282\u594f\uff1a\u8f7b\u5feb\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u6237\u5916\u8349\u576a": 1, "\u97f3\u4e50\u8282": 2, "\u513f\u7ae5\u4e50\u56ed\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u65cb\u5f8b\u8f7b\u5feb\u6109\u60a6\uff0c\u6b4c\u8bcd\u5185\u5bb9\u63a5\u5730\u6c14\uff0c\u80fd\u591f\u8ba9\u4eba\u56de\u5fc6\u7ae5\u5e74\uff0c\u6000\u5ff5\u61f5\u61c2\u7684\u5c81\u6708\uff0c\u9002\u5408\u5728\u6237\u5916\u8349\u576a": 1, "\u513f\u7ae5\u4e50\u56ed\u7b49\u573a\u666f\u653e\u9001\u3002": 1, "\u8212\u7f13": 3, "\u6709\u70b9\u751c\u871c": 1, "\u8ff7\u832b\u3002": 1, "\u60a0\u95f2": 1, "\u601d\u5ff5\u3002\u5e74\u4ee3\u548c\u8282\u594f\uff1a2000\u5e74\u4ee3\uff0c\u7f13\u6162\u7684\u8282\u594f\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u4e00\u4e2a\u4e0b\u96e8\u7684\u665a\u4e0a\uff0c\u5728\u5bb6\u91cc\u6216\u8005\u5496\u5561\u5385\u91cc\uff0c\u4e00\u4e2a\u4eba\u542c\u96e8": 1, "\u653e\u7a7a\u3002\u56e0\u4e3a\u6b4c\u66f2\u7684\u4f24\u611f\u60c5\u7eea\u548c\u7f13\u6162\u7684\u8282\u594f\u4e0e\u96e8\u5929\u7684\u6c1b\u56f4\u975e\u5e38\u76f8\u7b26\uff0c\u80fd\u591f\u8ba9\u4eba\u611f\u53d7\u5230\u66f4\u6df1\u5c42\u6b21\u7684\u60c5\u611f\u3002": 1, "\u7f31\u7efb": 1, "\u5fe7\u601d": 1, "\u53cd\u601d": 1, "\u601d\u7d22": 1, "\u5e84\u4e25": 2, "\u7565\u5e26\u5feb\u4e50": 1, "\u6297\u62d2": 1, "\u529b\u6c42\u63a5\u53d7": 1, "\u6fc0\u6602\u3002\u5e74\u4ee3\uff1a\u73b0\u4ee3\u3002\u8282\u594f\uff1a\u4e2d\u5feb\u8282\u594f\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u8352\u6f20": 1, "\u5c71\u6797": 1, "\u8fbd\u9614\u7684\u5927\u81ea\u7136\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u4e2d\u8868\u73b0\u4e86\u4fa0\u5ba2\u5b64\u72ec": 1, "\u4e0d\u5c48\u4e0d\u6320\u7684\u7cbe\u795e\uff0c\u9002\u5408\u5728\u5927\u81ea\u7136\u4e2d\u611f\u53d7\u81ea\u7531\u548c\u6311\u6218\u3002": 1, "\u611f\u4f24\u3002\u5e74\u4ee3\u548c\u8282\u594f\uff1a2000\u5e74\u4ee3\u4e2d\u671f\uff0c\u4e2d\u7f13\u8282\u594f\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u665a\u4e0a\u7684\u5496\u5561\u9986\u6216\u9152\u5427\uff0c\u843d\u5bde\u7684\u4eba\u4eec\u8046\u542c\u8fd9\u9996\u6b4c\u66f2\uff0c\u6c89\u6d78\u5728\u81ea\u5df1\u7684\u56de\u5fc6\u4e2d\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u7684\u5fe7\u90c1\u60c5\u7eea\u548c\u6292\u60c5\u65cb\u5f8b\u8ba9\u4eba\u4eec\u5728\u5bc2\u9759\u7684\u591c\u665a\u611f\u53d7\u5230\u81ea\u5df1\u7684\u60c5\u611f\uff0c\u8ba9\u4eba\u4eec\u6c89\u6d78\u5728\u56de\u5fc6\u4e2d\uff0c\u53cd\u601d\u81ea\u5df1\u7684\u8fc7\u53bb\u548c\u672a\u6765\u3002": 1, "\u65e0\u52a9\u3002": 1, "\u601d\u8003\u4e0e\u575a\u5b9a\uff1b\u5e74\u4ee3\u548c\u8282\u594f\uff1a\u73b0\u4ee3": 1, "\u7f13\u6162\uff1b\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u591c\u665a\u7684\u57ce\u5e02\u89d2\u843d\u6216\u8005\u5496\u5561\u5e97\u3002\u8fd9\u9996\u6b4c\u66f2\u901a\u8fc7\u5409\u4ed6\u548c\u548c\u58f0\u6f14\u5531\u7684\u6e29\u6696\u97f3\u8272\uff0c\u8868\u8fbe\u4e86\u73b0\u5b9e\u4e0e\u7406\u60f3\u7684\u77db\u76fe\uff0c\u601d\u8003\u4eba\u751f\u7684\u65b9\u5411\u4e0e\u575a\u5b9a\u4fe1\u4ef0\u7684\u51b3\u5fc3\u3002\u591c\u665a\u7684\u57ce\u5e02\u89d2\u843d\u6216\u8005\u5496\u5561\u5e97\uff0c\u662f\u4e00\u4e2a\u5b89\u9759": 1, "\u601d\u8003\u4eba\u751f\u7684\u5730\u65b9\uff0c\u975e\u5e38\u9002\u5408\u64ad\u653e\u8fd9\u9996\u6b4c\u66f2\u3002": 1, "\u656c\u4f69": 1, "\u6fc0\u52a8\u4eba\u5fc3": 1, "\u81ea\u7531\u3002\u5e74\u4ee3\uff1a2000\u5e74\u4ee3\u3002\u8282\u594f\uff1a\u4e2d\u7b49\u8282\u594f\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u8349\u539f\u6216\u7267\u573a\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u63cf\u8ff0\u4e86\u7267\u7f8a\u59d1\u5a18\u5728\u7f8e\u4e3d\u7684\u8349\u539f\u4e0a\u653e\u7f8a\u7684\u751f\u6d3b\uff0c\u8fd9\u79cd\u6b22\u5feb": 1, "\u81ea\u7531\u7684\u60c5\u7eea\u548c\u573a\u666f\u6700\u9002\u5408\u5728\u8349\u539f\u6216\u7267\u573a\u64ad\u653e\u3002": 1, "\u611f\u4f24\u3002\u5e74\u4ee3\uff1a2000\u5e74\u4ee3\u521d\u3002\u8282\u594f\uff1a\u4e2d\u7f13\u8282\u594f\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u591c\u665a\u7684\u57ce\u5e02\u8857\u5934\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u7684\u6e29\u99a8\u611f\u548c\u611f\u4f24\u60c5\u7eea\u9002\u5408\u591c\u665a\u57ce\u5e02\u7684\u6c1b\u56f4\u3002": 1, "\u70ed\u60c5\u6d0b\u6ea2": 1, "\u8c6a\u8fc8\u6fc0\u6602\u3002": 1, "\u604b\u7231": 1, "\u60b2\u89c2\u3002": 1, "\u6c89\u90c1\u3002": 1, "\u795d\u798f\u3002": 1, "\u6de1\u7136\uff1b\u5e74\u4ee3\uff1a2010\u5e74\u4ee3\uff1b\u8282\u594f\uff1a\u7f13\u6162\uff1b\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u96e8\u5929\u7684\u5496\u5561\u9986\u6216\u9759\u8c27\u7684\u516c\u56ed\u3002\u56e0\u4e3a\u6b4c\u66f2\u7684\u6de1\u7136\u60c5\u7eea\u548c\u8212\u7f13\u7684\u8282\u594f\u9002\u5408\u5728\u8fd9\u6837\u7684\u573a\u666f\u4e2d\u653e\u677e\u5fc3\u60c5\uff0c\u611f\u53d7\u751f\u6d3b\u7684\u53d8\u5316\u548c\u6210\u957f\u3002": 1, "\u6e29\u99a8\uff1b\u5e74\u4ee3\uff1a2010\u5e74\u4ee3\uff1b\u8282\u594f\uff1a\u4e2d\u7b49\u5feb\u901f\uff1b\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u591c\u665a\u7684\u57ce\u5e02\u516c\u56ed\u6216\u6d77\u6ee9\uff1b\u539f\u56e0\uff1a\u6b4c\u66f2\u7684\u6d6a\u6f2b\u60c5\u611f\u548c\u8212\u7f13\u8282\u594f\u9002\u5408\u5728\u5b89\u9759\u7684\u6237\u5916\u73af\u5883\u4e2d\u8046\u542c\uff0c\u5c24\u5176\u662f\u5728\u591c\u665a\u7684\u516c\u56ed\u6216\u6d77\u6ee9\uff0c\u66f4\u80fd\u589e\u52a0\u6d6a\u6f2b\u6c1b\u56f4\u3002": 1, "\u5145\u6ee1\u5e0c\u671b": 3, "\u6fc0\u52b1\u548c\u9f13\u821e": 1, "\u79ef\u6781\u5411\u4e0a\uff0c\u6fc0\u52b1\u4eba\u5fc3\u3002": 1, "\u6000\u5ff5\u3002\u5e74\u4ee3\uff1a2012\u5e74\u3002\u8282\u594f\uff1a\u4e2d\u7f13\u8282\u594f\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u9759\u8c27\u7684\u591c\u665a": 1, "\u5496\u5561\u9986": 1, "\u6d77\u8fb9\u7b49\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u7684\u4f24\u611f\u65cb\u5f8b\u548c\u6b4c\u8bcd\u9002\u5408\u5728\u5b89\u9759\u7684\u73af\u5883\u4e2d\u8046\u542c\uff0c\u8425\u9020\u51fa\u4e00\u79cd\u5fe7\u4f24\u7684\u6c1b\u56f4\uff0c\u80fd\u5f15\u8d77\u542c\u4f17\u7684\u5171\u9e23\u548c\u601d\u8003\u3002": 1, "\u6cbb\u6108": 1, "\u75db\u5feb": 1, "\u7565\u5e26\u4f24\u611f\u3002": 1, "\u4e61\u6101": 1, "\u6fc0\u60c5\uff1b\u5e74\u4ee3\uff1a2010\u5e74\u4ee3\uff1b\u8282\u594f\uff1a\u4e2d\u7b49\uff1b\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u97f3\u4e50\u8282\u73b0\u573a\u6216\u4e2a\u4eba\u542c\u6b4c\u65f6\uff1b\u89e3\u91ca\uff1a\u6b4c\u66f2\u7684\u8282\u594f\u548c\u60c5\u7eea\u80fd\u591f\u6fc0\u53d1\u4eba\u4eec\u7684\u81ea\u4fe1\u548c\u6fc0\u60c5\uff0c\u9002\u5408\u5728\u5145\u6ee1\u6d3b\u529b\u7684\u97f3\u4e50\u8282\u73b0\u573a\u64ad\u653e\u3002\u540c\u65f6\uff0c\u6b4c\u66f2\u4e5f\u9002\u5408\u4e2a\u4eba\u5728\u72ec\u5904\u65f6\u542c\uff0c\u8ba9\u4eba\u4eec\u66f4\u597d\u7684\u8868\u8fbe\u81ea\u6211\u548c\u575a\u6301\u4fe1\u4ef0\u3002": 1, "\u601d\u5ff5\u3002\u5e74\u4ee3\uff1a\u73b0\u4ee3\u3002\u8282\u594f\uff1a\u7f13\u6162\u3002\u6700\u4f73\u573a\u666f\uff1a\u6df1\u591c\u9759\u8c27\u7684\u623f\u95f4\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u65cb\u5f8b\u67d4\u7f8e\uff0c\u6b4c\u8bcd\u6df1\u60c5\uff0c\u9002\u5408\u5728\u5b89\u9759\u7684\u73af\u5883\u4e2d\u8046\u542c\uff0c\u5f15\u53d1\u5171\u9e23\u3002": 1, "\u81ea\u7701\u3002": 1, "\u6fc0\u52b1\uff0c\u9f13\u821e": 1, "\u8212\u9002\u3002": 1, "\u611f\u52a8\uff1b\u5e74\u4ee3\uff1a\u73b0\u4ee3\uff1b\u8282\u594f\uff1a\u4e2d\u901f\u6d41\u7545\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u9732\u5929\u97f3\u4e50\u8282\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u65cb\u5f8b\u4f18\u7f8e\uff0c\u8282\u594f\u6d41\u7545\uff0c\u5145\u6ee1\u6fc0\u52b1\u548c\u611f\u52a8\uff0c\u975e\u5e38\u9002\u5408\u5728\u6237\u5916\u97f3\u4e50\u8282\u4e0a\u6f14\u5531\uff0c\u80fd\u591f\u6fc0\u53d1\u4eba\u4eec\u7684\u70ed\u60c5\u548c\u68a6\u60f3\u8ffd\u6c42\u3002": 1, "\u6177\u6168\u6fc0\u6602\uff1b\u5e74\u4ee3\uff1a20\u4e16\u7eaa\u521d\uff1b\u8282\u594f\uff1a\u7f13\u6162": 1, "\u8212\u7f13\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u5728\u4fc4\u7f57\u65af\u5e7f\u88a4\u7684\u7530\u91ce\u548c\u7267\u573a\u4e2d\u6f14\u5531\uff0c\u56e0\u4e3a\u6b4c\u66f2\u8868\u8fbe\u4e86\u5bf9\u7956\u56fd\u7684\u70ed\u7231\u548c\u8d5e\u7f8e\u3002": 1, "\u51c4\u51c9": 1, "\u8f7b\u677e\uff0c\u6109\u60a6": 1, "\u5e7d\u9ed8": 2, "\u6000\u5ff5\u3002\u5e74\u4ee3\uff1a1990\u5e74\u4ee3\u3002\u8282\u594f\uff1a\u7f13\u6162": 1, "\u67d4\u548c\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u591c\u665a\u7684\u57ce\u5e02\u516c\u56ed\u6216\u6d77\u8fb9\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u7684\u6292\u60c5\u548c\u67d4\u548c\u7684\u8282\u594f\u9002\u5408\u591c\u665a\u7684\u5b89\u9759\u6c1b\u56f4\uff0c\u80fd\u591f\u8ba9\u4eba\u6c89\u6d78\u5728\u601d\u5ff5\u548c\u56de\u5fc6\u4e2d\u3002": 1, "\u8212\u7545": 1, "\u5174\u594b\u548c\u653e\u677e": 1, "\u8c6a\u8fc8\u3002": 1, "\u5931\u843d\uff1b\u5e74\u4ee3\uff1a2000\u5e74\u4ee3\uff1b\u8282\u594f\uff1a\u7f13\u6162\uff1b\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u96e8\u4e2d\u6563\u6b65\u6216\u5728\u5bb6\u542c\u96e8\u58f0\u7684\u591c\u665a\uff0c\u56e0\u4e3a\u6b4c\u66f2\u7684\u4e3b\u9898\u548c\u60c5\u7eea\u4e0e\u96e8\u6c34\u76f8\u547c\u5e94\uff0c\u4ee4\u4eba\u611f\u5230\u5b64\u72ec\u548c\u65e0\u52a9\u3002": 1, "\u5fe7\u90c1\u3002": 1, "\u6fc0\u60c5\u6f8e\u6e43": 1, "\u60b2\u58ee\u611f\u4eba": 1, "\u53cd\u6297\u3002": 1, "\u4f24\u611f/\u6000\u5ff5": 1, "\u594b\u6597\u3002\u5e74\u4ee3\uff1a2010\u5e74\u4ee3\u3002\u8282\u594f\uff1a\u4e2d\u5feb\u8282\u594f\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u6148\u5584\u52df\u6350\u6d3b\u52a8": 1, "\u793e\u533a\u670d\u52a1\u4e2d\u5fc3\u7b49\uff0c\u56e0\u4e3a\u6b4c\u66f2\u8868\u8fbe\u4e86\u62ef\u6551\u548c\u5e2e\u52a9\u4ed6\u4eba\u7684\u4e3b\u9898\uff0c\u9002\u5408\u5728\u8fd9\u4e9b\u573a\u666f\u4e2d\u64ad\u653e\u4ee5\u6fc0\u52b1\u4eba\u4eec\u7684\u5949\u732e\u548c\u4ed8\u51fa\u3002": 1, "\u56f0\u60d1": 1, "\u65e2\u6709\u6109\u60a6\u7684\u6b23\u8d4f\u7f8e\u597d\u7684\u6625\u591c\uff0c\u53c8\u6709\u5bf9\u6d41\u5e74\u901d\u53bb\u548c\u4eba\u751f\u77ed\u6682\u7684\u611f\u6168\u548c\u5fe7\u4f24\u3002": 1, "\u6f47\u6d12": 1, "\u6df7\u4e71": 1, "\u6de1\u7136\u5fe7\u4f24": 1, "\u8f7b\u677e\u3002\u5e74\u4ee3\uff1a1970\u5e74\u4ee3\u3002\u8282\u594f\uff1a\u4e2d\u7b49\u8282\u594f\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u6d77\u6e2f\u7801\u5934\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u4e3b\u9898\u4e0e\u573a\u666f\u76f8\u7b26\u5408\uff0c\u80fd\u591f\u8ba9\u4eba\u611f\u53d7\u5230\u5927\u8239\u5165\u6e2f\u5e26\u6765\u7684\u559c\u60a6\u548c\u8f7b\u677e\u3002": 1, "\u5b81\u9759": 1, "\u5e73\u548c": 2, "\u79ef\u6781\u5411\u4e0a\uff0c\u81ea\u4fe1\u4e50\u89c2\u3002": 1, "\u5192\u9669": 1, "\u8ff7\u79bb": 1, "\u67d4\u60c5\u3002\u5e74\u4ee3\uff1a1990\u5e74\u4ee3\u3002\u8282\u594f\uff1a\u6162\u677f\u3002\u64ad\u653e\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u591c\u665a\u7684\u6708\u5149\u4e0b\uff0c\u60c5\u4eba\u76f8\u5bf9\u800c\u5750\uff0c\u5171\u8d4f\u7f8e\u666f\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u7684\u6df1\u60c5\u65cb\u5f8b\u548c\u6b4c\u8bcd\uff0c\u4e0e\u6708\u5149\u4e0b\u7684\u6d6a\u6f2b\u6c1b\u56f4\u76f8\u5f97\u76ca\u5f70\u3002": 1, "\u6fc0\u6602\uff0c\u81ea\u8c6a\uff0c\u6311\u6218": 1, "\u67d4\u60c5\u3002\u5e74\u4ee3\uff1a2010\u5e74\u4ee3\u3002\u8282\u594f\uff1a\u7f13\u6162\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u591c\u665a": 1, "\u96e8\u5929\u6216\u72ec\u81ea\u9759\u601d\u7684\u65f6\u523b\uff0c\u56e0\u4e3a\u6b4c\u66f2\u7684\u60c5\u611f\u8868\u8fbe\u9002\u5408\u5728\u5b89\u9759\u7684\u73af\u5883\u4e2d\u611f\u53d7\u3002": 1, "\u601d\u5ff5\uff1b\u5e74\u4ee3\uff1a\u73b0\u4ee3\uff1b\u8282\u594f\uff1a\u7f13\u6162\u67d4\u548c\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u591c\u665a\u7684\u57ce\u5e02\u8857\u9053\u6216\u9759\u8c27\u7684\u5c71\u6c34\u4e4b\u95f4\uff0c\u56e0\u4e3a\u6b4c\u66f2\u7684\u65cb\u5f8b\u548c\u6b4c\u8bcd\u80fd\u591f\u8425\u9020\u51fa\u4e00\u79cd\u6df1\u6c89\u7684\u60c5\u611f\u6c1b\u56f4\uff0c\u8ba9\u4eba\u6c89\u6d78\u5728\u56de\u5fc6\u548c\u601d\u8003\u4e2d\u3002": 1, "\u5b81\u9759\u3002": 1, "\u4f24\u611f\uff1b\u5e74\u4ee3\uff1a\u73b0\u4ee3\uff1b\u8282\u594f\uff1a\u7f13\u6162\uff1b\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u665a\u4e0a\u5728\u6708\u5149\u4e0b\u6563\u6b65\u6216\u591c\u665a\u7684\u9152\u5427\u3002\u56e0\u4e3a\u6b4c\u66f2\u65cb\u5f8b\u4f18\u7f8e\uff0c\u6b4c\u8bcd\u6df1\u60c5\uff0c\u9002\u5408\u5728\u5b89\u9759\u7684\u591c\u665a\u6216\u6d6a\u6f2b\u7684\u573a\u666f\u4e2d\u6b23\u8d4f\u3002": 1, "\u8f7b\u677e\uff0c\u6109\u60a6\u3002": 1, "\u6267\u7740\u3002\u5e74\u4ee3\uff1a2000\u5e74\u4ee3\u3002\u8282\u594f\uff1a\u7f13\u6162\u67d4\u548c\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u591c\u665a\u7684\u57ce\u5e02\u8857\u9053\u6216\u6d77\u8fb9\uff0c\u9002\u5408\u5728\u4e00\u6bb5\u611f\u60c5\u7ea0\u845b\u7684\u6545\u4e8b\u4e2d\u4f7f\u7528\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u65cb\u5f8b\u4f18\u7f8e": 1, "\u60c5\u611f\u6df1\u523b\uff0c\u80fd\u591f\u4f53\u73b0\u51fa\u7231\u60c5\u4e2d\u7684\u575a\u6301\u548c\u6267\u7740\uff0c\u8ba9\u4eba\u611f\u53d7\u5230\u7231\u60c5\u7684\u771f\u631a\u548c\u7f8e\u597d\u3002": 1, "\u6b23\u559c\u3002": 1, "\u5bbd\u5bb9": 1, "\u8f7b\u677e\u6109\u5feb": 1, "\u6e29\u99a8\u611f\u52a8": 1, "\u575a\u97e7\uff1b\u5e74\u4ee3\u548c\u8282\u594f\uff1a\u73b0\u4ee3": 1, "\u7f13\u6162\uff1b\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u5bc2\u9759\u7684\u591c\u665a\uff0c\u96ea\u82b1\u7eb7\u98de\u7684\u5c71\u6797\u6216\u8352\u91ce\uff0c\u56e0\u4e3a\u6b4c\u66f2\u4e2d\u7684\u6c1b\u56f4\u548c\u60c5\u611f\u4e0e\u8fd9\u6837\u7684\u73af\u5883\u76f8\u5f97\u76ca\u5f70\u3002": 1, "\u54c0\u6028\u3002\u5e74\u4ee3\uff1a2010\u5e74\u4ee3\u3002\u8282\u594f\uff1a\u4e2d\u7f13\u8282\u594f\u3002": 1, "\u60b2\u4f24\u4e0e\u6124\u6012\u3002": 1, "\u6e29\u67d4\uff0c\u611f\u6027": 1, "\u6709\u4e9b\u4f24\u611f": 1, "\u5411\u4e0a\u3002": 1, "\u81ea\u5351": 1, "\u60b2\u6124": 1, "\u5145\u6ee1\u5e0c\u671b\u548c\u4e50\u89c2\u3002": 1, "\u60b2\u54c0": 1, "\u5b89\u9759\u3002": 1, "\u80cc\u53db": 1, "\u4f24\u5fc3\u3002": 1, "\u68a6\u5e7b\u3002\u5e74\u4ee3\u548c\u8282\u594f\uff1a2010\u5e74\u4ee3": 1, "\u4e2d\u6162\u8282\u594f\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u591c\u665a\u7684\u6d77\u6ee9\u6216\u57ce\u5e02\u8857\u9053\uff0c\u56e0\u4e3a\u6b4c\u66f2\u7684\u6e29\u6696\u548c\u68a6\u5e7b\u611f\u53ef\u4ee5\u589e\u5f3a\u8fd9\u4e9b\u5730\u65b9\u7684\u6d6a\u6f2b\u6c1b\u56f4\u3002": 1, "\u91ca\u653e": 1, "\u653e\u677e\u548c\u5e73\u9759\u3002": 1, "\u5e0c\u671b\uff1b\u5e74\u4ee3\uff1a2000\u5e74\u4ee3\uff1b\u8282\u594f\uff1a\u4e2d\u7b49\u8282\u594f\uff1b\u6700\u4f73\u573a\u666f/\u5b9e\u9645\u5730\u70b9\uff1a\u6821\u56ed": 1, "\u6f14\u5531\u4f1a\u7b49\uff1b\u539f\u56e0\uff1a\u6b4c\u66f2\u6fc0\u52b1\u4eba\u4eec\u7528\u7231\u53bb\u6539\u53d8\u73b0\u72b6\uff0c\u8ba9\u672a\u6765\u66f4\u52a0\u7f8e\u597d\u3002": 1, "\u601d\u5ff5\uff1b\u5e74\u4ee3\uff1a2010\u5e74\u4ee3\uff1b\u8282\u594f\uff1a\u6162\u677f\uff1b\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u96e8\u5929\u7684\u5496\u5561\u5385\u6216\u9759\u8c27\u7684\u591c\u665a\uff0c\u56e0\u4e3a\u6b4c\u66f2\u7684\u843d\u5bde\u548c\u6c89\u9759\u4e0e\u8fd9\u4e9b\u573a\u666f\u76f8\u5f97\u76ca\u5f70\u3002": 1, "\u611f\u4eba\u81f3\u6df1": 1, "\u5d07\u656c\u548c\u611f\u6fc0\u3002": 1, "\u601d\u8003\uff1b\u5e74\u4ee3\uff1a2000\u5e74\u4ee3\uff1b\u8282\u594f\uff1a\u4e2d\u7b49\uff1b\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u665a\u4e0a\u5728\u5b89\u9759\u7684\u623f\u95f4\u91cc\uff0c\u6216\u8005\u5728\u591c\u666f\u7f8e\u4e3d\u7684\u57ce\u5e02\u8857\u5934\u6563\u6b65\uff0c\u56e0\u4e3a\u6b4c\u66f2\u4e2d\u7684\u4e3b\u9898\u548c\u60c5\u611f\u9002\u5408\u5728\u5b89\u9759\u7684\u73af\u5883\u4e2d\u601d\u8003\uff0c\u6216\u8005\u5728\u591c\u666f\u7f8e\u4e3d\u7684\u57ce\u5e02\u4e2d\u53d1\u5446\u3002": 1, "\u5e84\u4e25\u8083\u7a46": 1, "\u6021\u7136\u3002": 1, "\u6b23\u6b23\u5411\u8363": 1, "\u81ea\u6211\u63a2\u7d22": 1, "\u4f24\u5fc3": 1, "\u5145\u6ee1\u601d\u5ff5": 1, "\u5145\u6ee1\u5192\u9669\u7684\u611f\u89c9": 1, "\u9178\u695a": 1, "\u5174\u594b\u3002\u5e74\u4ee3\uff1a1990\u5e74\u4ee3\u3002\u8282\u594f\uff1a\u5feb\u901f\u8df3\u52a8\u3002\u6700\u4f73\u573a\u666f\u6216\u5b9e\u9645\u5730\u70b9\uff1a\u6d3e\u5bf9": 1, "\u821e\u5385\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u5145\u6ee1\u6d3b\u529b\u548c\u5feb\u4e50\uff0c\u9002\u5408\u5728\u6b22\u4e50\u7684\u573a\u5408\u64ad\u653e\u3002": 1, "\u51c4\u51c9\uff1b\u5e74\u4ee3\uff1a2010\u5e74\u4ee3\uff1b\u8282\u594f\uff1a\u7f13\u6162\uff1b\u6700\u4f73\u573a\u666f\uff1a\u665a\u4e0a\u9759\u8c27\u7684\u5496\u5561\u5385\u6216\u4e66\u623f\uff0c\u8ba9\u4eba\u6c89\u6d78\u5728\u601d\u8003\u548c\u56de\u5fc6\u4e2d\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u7684\u6de1\u7136\u60c5\u7eea\u548c\u51c4\u51c9\u4e3b\u9898\uff0c\u914d\u5408\u7f13\u6162\u7684\u8282\u594f\u548c\u5f26\u4e50": 1, "\u8427\u7b49\u4e50\u5668\u7684\u6e32\u67d3\uff0c\u8ba9\u4eba\u611f\u5230\u601d\u8003\u548c\u56de\u5fc6\u7684\u6c1b\u56f4\u3002": 1, "\u60f3\u5ff5": 1, "\u575a\u97e7": 1, "\u8c41\u8fbe\uff1b\u5e74\u4ee3\uff1a2019\u5e74\uff1b\u8282\u594f\uff1a\u7f13\u6162": 1, "\u6292\u60c5\uff1b\u64ad\u653e\u573a\u666f\uff1a\u5c71\u95f4\u5c0f\u6eaa": 1, "\u9759\u8c27\u4e66\u623f\u7b49\u3002\u539f\u56e0\uff1a\u6b4c\u66f2\u65cb\u5f8b\u4f18\u7f8e\uff0c\u6b4c\u8bcd\u5145\u6ee1\u54f2\u7406\uff0c\u9002\u5408\u5728\u5b89\u9759\u7684\u73af\u5883\u4e2d\u8046\u542c\u3002": 1, "\u8c6a\u8fc8\u6fc0\u6602\uff0c\u5bcc\u6709\u60b2\u58ee\u611f\u3002": 1, "\u4e0d\u5c48": 1, "\u81ea\u4fe1\u3002": 1, "\u8ffd\u5fc6\u548c\u601d\u5ff5\u3002": 1, "\u8212\u7f13\u3002": 1, "\u6124\u6168": 1, "\u6323\u624e\u3002": 1}